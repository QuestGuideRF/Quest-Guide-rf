# ============================================
# ОБЩАЯ КОНФИГУРАЦИЯ QuestGuideRF
# Скопируйте этот файл в .env в корне проекта.
# Реальные токены, пароли и секреты сюда не добавляйте.
# ============================================

# Telegram Bot
BOT_TOKEN=123456:replace_with_botfather_token
BOT_USERNAME=questguiderf_bot

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quest_guide
DB_USER=quest_guide_user
DB_PASS=replace_with_your_db_pass
DB_PASSWORD=replace_with_your_db_password

# Настройки сайта
SITE_URL=https://questguiderf.ru
DEBUG=false

# Интеграция с сайтом
AUTH_SECRET=change_this_to_random_string
API_SECRET=
# API_SECRET=change_this_to_random_string

# OAuth вход через Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://questguiderf.ru/auth/oauth_callback.php?provider=google

# OAuth вход через Яндекс
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://questguiderf.ru/auth/oauth_callback.php?provider=yandex

# Telegram ID администраторов и модераторов (через запятую без пробелов)
ADMIN_IDS=123456789,987654321
MODERATOR_IDS=

# Telegram Stars
PAYMENT_PROVIDER_TOKEN=

# ЮKassa
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# Платежи
DEFAULT_PRICE=399

# Google Cloud Vision API (опционально)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_CLOUD_PROJECT=

# Пути к файлам
PHOTOS_DIR=../uploads/users
REFERENCE_PHOTOS_DIR=../uploads/reference
TEMP_DIR=../uploads/temp

# Проверка фото
SIMILARITY_THRESHOLD=0.75
POSE_CONFIDENCE=0.5

# Антифрод
MAX_PHOTOS_PER_HOUR=30
MIN_PHOTO_INTERVAL_SEC=5

# Логирование
LOG_LEVEL=INFO
